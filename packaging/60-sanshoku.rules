# The union of docs/udev.md: every vendor the module drives, tagged so the
# logged-in user may open the node. systemd-logind puts an ACL on a device
# tagged "uaccess" for whoever is at the seat; without it the driver finds
# the device and cannot open it, and the reason is invisible.
#
# Matched by vendor, not product, so this file does not have to be edited in
# step with a driver's allow-list. Matched on the device itself, not on a
# parent: a hidraw node through its HID device's name, 0003 (USB) and the
# vendor, which no hub carries; the NZXT USB node by its own attribute. A
# vendor on any parent would tag every device behind that vendor's hub (#65).

# Logitech (HID++ receivers and wired devices)
KERNEL=="hidraw*", KERNELS=="0003:046D:*", TAG+="uaccess"
# Razer (docks and dongles)
KERNEL=="hidraw*", KERNELS=="0003:1532:*", TAG+="uaccess"
# SteelSeries
KERNEL=="hidraw*", KERNELS=="0003:1038:*", TAG+="uaccess"
# NZXT: the status channel as hidraw, the LCD's bulk endpoint as the USB node
KERNEL=="hidraw*", KERNELS=="0003:1E71:*", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1e71", TAG+="uaccess"
# AULA keyboards' 2.4 GHz receiver (Compx chip).
KERNEL=="hidraw*", KERNELS=="0003:3554:*", TAG+="uaccess"
# The AULA F75 on its cable (Sino Wealth chip): by product, because the vendor
# is a chip maker's and is on many other keyboards and mice.
KERNEL=="hidraw*", KERNELS=="0003:258A:010C.*", TAG+="uaccess"
# Sony DualSense and DualSense Edge, over USB or Bluetooth: by product and HID
# ID, because Sony headphones share the vendor and Bluetooth has no USB parent.
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", TAG+="uaccess"
